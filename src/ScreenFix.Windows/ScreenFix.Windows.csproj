<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>ScreenFix.Windows.Program</StartupObject>
    <AssemblyName>ScreenFix</AssemblyName>
    <RootNamespace>ScreenFix.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ScreenFix.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <Company>ScreenFix</Company>
    <Product>ScreenFix</Product>
    <Description>Centered display profiles and monitor navigation for Windows.</Description>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScreenFix.Core/ScreenFix.Core.csproj" />
    <Resource Include="Assets/ScreenFix.ico" />
  </ItemGroup>
</Project>
