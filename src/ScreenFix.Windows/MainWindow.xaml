<Window x:Class="ScreenFix.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFix" Width="800" Height="900" MinWidth="680" MinHeight="620"
        Background="#10171E" FontFamily="Segoe UI" Foreground="#EDF4FA"
        Icon="Assets/ScreenFix.ico" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,24,30,24">
      <DockPanel Margin="0,0,0,6">
        <Border DockPanel.Dock="Right" Background="#22323B" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
          <TextBlock x:Name="StateBadge" Text="ПОЛНЫЙ ЭКРАН" FontSize="11" FontWeight="SemiBold" Foreground="#6CE5C2" />
        </Border>
        <TextBlock Text="ScreenFix" FontSize="30" FontWeight="SemiBold" />
      </DockPanel>
      <TextBlock Text="Ваш монитор. Нужный размер." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,22" />

      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить" Padding="10,5" Margin="8,0,0,0" Click="RefreshClick" />
            <TextBlock Text="Игровой монитор" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ComboBox x:Name="MonitorPicker" SelectionChanged="MonitorChanged" AutomationProperties.Name="Игровой монитор" />
          <TextBlock x:Name="MonitorInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,16" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Диагональ монитора, дюймы" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
              <TextBox x:Name="PhysicalInput" Text="27" TextChanged="SizeChangedInput" AutomationProperties.Name="Физическая диагональ монитора в дюймах" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="24" Margin="0,0,0,7" Foreground="#6CE5C2" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="Желаемая диагональ, дюймы" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
              <TextBox x:Name="TargetInput" Text="24" TextChanged="SizeChangedInput" AutomationProperties.Name="Желаемая диагональ в дюймах" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="SizeSummary" Text="27″ → 24″" FontWeight="SemiBold" FontSize="17" />
            <TextBlock x:Name="HzSummary" Text="Частота сохраняется" Foreground="#6CE5C2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </DockPanel>
          <Viewbox Stretch="Uniform" MaxHeight="220" Margin="0,12,0,5">
            <Canvas Width="690" Height="310" ClipToBounds="True">
              <Rectangle x:Name="PreviewMonitor" Canvas.Left="8" Canvas.Top="8" Width="500" Height="281.25" Fill="Black" Stroke="#4A5C6B" StrokeThickness="2" RadiusX="8" RadiusY="8" />
              <Border x:Name="PreviewArea" Canvas.Left="36" Canvas.Top="24" Width="444.44" Height="250" CornerRadius="3" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#254F58" Offset="0" /><GradientStop Color="#348B78" Offset="1" /></LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="PreviewDiagonal" Text="24″" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="PreviewResolution" Text="Область игры" FontSize="16" HorizontalAlignment="Center" Foreground="#D0F8ED" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="PreviewArrow" Canvas.Left="515" Canvas.Top="125" Text="↔" FontSize="26" Foreground="#6CE5C2" />
              <Border x:Name="PreviewSecond" Canvas.Left="555" Canvas.Top="70" Width="125" Height="155" BorderBrush="#4A5C6B" BorderThickness="2" Background="#21313E" CornerRadius="6">
                <TextBlock Text="Второй&#10;монитор" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
              </Border>
            </Canvas>
          </Viewbox>
          <TextBlock Text="Размер изображения" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,6" />
          <ComboBox x:Name="SizePicker" SelectionChanged="SizeChosen" Margin="0,0,0,10" AutomationProperties.Name="Размер изображения" />
          <TextBlock x:Name="PlanInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <CheckBox x:Name="ReconnectInput" Content="Прямой переход на соседний монитор" IsChecked="True" Margin="0,16,0,6" />
          <TextBlock Text="Соседние экраны стыкуются в схеме Windows. Свободный курсор сразу переходит между ними в обе стороны, пропуская чёрные поля." Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>
      </Border>

      <Border x:Name="StatusPanel" Background="#1C2B36" CornerRadius="9" Padding="15" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="Выберите монитор и желаемую диагональ." FontSize="13" />
          <Button x:Name="UseCurrentButton" Content="Принять текущий экран как исходный" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Left" Click="UseCurrentClick" />
          <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="CountdownText" Text="Автовозврат через 15 секунд" FontWeight="SemiBold" Margin="0,0,0,10" />
            <WrapPanel>
              <Button Content="Оставить этот размер" Background="#6CE5C2" Foreground="#0C2822" Click="KeepClick" />
              <Button Content="Вернуть сейчас" Click="RestoreClick" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,0,0,14">
        <Button x:Name="ApplyButton" Content="Включить уменьшение" Background="#6CE5C2" Foreground="#0C2822" FontWeight="SemiBold" Click="ApplyClick" />
        <Button x:Name="RestoreButton" Content="Вернуть экран" Click="RestoreClick" />
        <Button x:Name="ProbeButton" Content="Проверить режимы" Click="ProbeClick" ToolTip="Спрашивает у драйвера, какие размеры он принимает. Экран при этом не меняется." />
        <Button Content="В трей" Click="HideClick" Margin="0" />
      </WrapPanel>
      <TextBlock Text="Ctrl + Alt + F10 — включить / отключить     ·     Ctrl + Alt + F11 — вернуть экран" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9" />
      <TextBlock Text="Для сохранения пропорций чёрные поля будут со всех сторон. Полноэкранная игра может изменить режим драйвера; при конфликте ScreenFix отключит профиль и сообщит об этом. Захваченный игрой курсор остаётся в игре." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,13" />
      <DockPanel>
        <Button Content="Сохранить диагностику" Padding="10,6" Click="DiagnosticsClick" />
        <TextBlock x:Name="VersionText" Text="Работает локально · без прав администратора" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
